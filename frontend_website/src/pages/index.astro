---
import Layout from "../layouts/Layout.astro";
import words from "../lib/words.ts";
---

<Layout title="67Conductor - AI Fashion Finder">
  <div id="container" class="min-h-screen bg-slate-950 text-white flex flex-col justify-between overflow-x-hidden" style="background: radial-gradient(circle at center, #0f172a 0%, #090d16 100%);">
    
    <!-- Header -->
    <header class="py-5 px-8 border-b border-zinc-800/40 backdrop-blur-md sticky top-0 z-50 flex justify-between items-center bg-zinc-950/40">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l8.973-1.055L21 12l-8.973-1.055L9.813 15.904z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 21L3 15M3 15l6-6M3 15h12"/>
          </svg>
        </div>
        <span class="text-lg font-bold tracking-tight bg-gradient-to-r from-indigo-200 via-indigo-400 to-violet-300 bg-clip-text text-transparent">67Conductor</span>
      </div>
      <nav class="flex items-center space-x-6 text-sm">
        <a href="/" class="text-white font-medium hover:text-indigo-400 transition-colors duration-200">Fashion Matcher</a>
        <a href="/model" class="text-zinc-400 font-medium hover:text-white transition-colors duration-200">Browser Pose Model</a>
      </nav>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow flex flex-col items-center justify-center px-4 py-12 max-w-5xl mx-auto w-full">
      <div class="text-center mb-10">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-500 bg-clip-text text-transparent mb-4">Discover Your Style</h1>
        <p class="text-zinc-400 text-sm max-w-md mx-auto">Select style preferences below to generate tailored AI suggestions and swipe through items.</p>
      </div>

      <!-- Preference Grid -->
      <div id="preferences-section" class="w-full bg-zinc-900/30 border border-zinc-800/60 rounded-3xl p-8 backdrop-blur-xl shadow-2xl flex flex-col items-center">
        <h2 class="text-sm font-semibold text-zinc-400 mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
          Select tags to customize recommendations:
        </h2>
        
        <div id="word-grid" class="flex flex-wrap justify-center gap-3 mb-8 w-full max-w-3xl">
          {JSON.parse(words()).words.map((word: string) => (
            <button
              type="button"
              data-word={word}
              class="word-btn px-5 py-2 rounded-full border border-zinc-800 bg-zinc-950/30 text-zinc-300 hover:text-white hover:bg-zinc-850 hover:border-zinc-700 hover:-translate-y-0.5 text-xs font-semibold tracking-wide transition-all duration-200 cursor-pointer"
              aria-pressed="false"
            >
              #{word}
            </button>
          ))}
        </div>

        <!-- Action Bar -->
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <div class="text-zinc-400 text-xs bg-zinc-950/60 border border-zinc-850 px-4 py-2.5 rounded-full">
            Selected: <span id="selectedCount" class="font-bold text-indigo-400">0</span>
          </div>
          <button id="nextBtn" class="px-7 py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs tracking-wider shadow-lg shadow-indigo-600/10 hover:shadow-indigo-500/20 transition-all duration-200 flex items-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-indigo-600 cursor-pointer" disabled>
            ANALYZE STYLE
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Recommendation View (Initially Hidden) -->
      <div id="recommendation-section" class="hidden w-full max-w-md flex flex-col items-center">
        <!-- Back Button -->
        <button id="backBtn" class="self-start mb-4 px-4 py-2 rounded-full border border-zinc-850 bg-zinc-900/30 hover:bg-zinc-850 text-zinc-400 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition-colors duration-200 cursor-pointer">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Modify Tags
        </button>

        <!-- Tinder-Style Recommendation Card -->
        <div id="recommendation-card" class="w-full bg-zinc-950/40 border border-zinc-800/80 rounded-3xl p-6 shadow-2xl relative overflow-hidden backdrop-blur-2xl transition-all duration-300">
          
          <!-- Loading Overlay -->
          <div id="card-loading" class="absolute inset-0 bg-zinc-950/90 backdrop-blur-md z-30 flex flex-col justify-center items-center opacity-0 pointer-events-none transition-opacity duration-300">
            <div class="w-10 h-10 rounded-full border-4 border-indigo-500/20 border-t-indigo-500 animate-spin mb-3"></div>
            <p class="text-zinc-400 text-xs font-semibold">Consulting LLM recommendation...</p>
          </div>

          <!-- Recommendation Content -->
          <div id="card-content" class="flex flex-col h-full justify-between min-h-[280px]">
            <div>
              <div class="flex justify-between items-center mb-6">
                <span class="text-[10px] font-bold text-indigo-400 tracking-widest uppercase bg-indigo-950/30 border border-indigo-900/60 px-2 py-0.5 rounded">AI SUGGESTION</span>
                <span class="text-xs text-zinc-500 font-mono" id="suggested-time">Ready</span>
              </div>

              <!-- Recommendation Title/Category -->
              <h3 id="recommendation-title" class="text-xl font-bold tracking-tight text-white mb-3">Loading Suggestion...</h3>
              
              <!-- Recommendation Description -->
              <p id="recommendation-desc" class="text-zinc-400 text-xs leading-relaxed mb-6">
                Analyzing your selections to generate the clothing suggestion.
              </p>
            </div>

            <!-- Like/Dislike Swiping Buttons -->
            <div class="flex justify-center items-center gap-4 mt-6">
              <!-- Dislike Button -->
              <button id="dislikeBtn" class="w-12 h-12 rounded-full border border-red-500/20 bg-red-950/10 hover:bg-red-500 text-red-500 hover:text-white flex items-center justify-center shadow-lg transition-all duration-200 cursor-pointer active:scale-95">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
              
              <!-- Like Button -->
              <button id="likeBtn" class="w-12 h-12 rounded-full border border-emerald-500/20 bg-emerald-950/10 hover:bg-emerald-500 text-emerald-500 hover:text-white flex items-center justify-center shadow-lg transition-all duration-200 cursor-pointer active:scale-95">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="py-6 border-t border-zinc-900/60 text-center text-xs text-zinc-650">
      <p>© 2026 67Conductor Project. Cleaned & prepared for public release.</p>
    </footer>
  </div>

  <style is:global>
    .word-btn.selected {
      background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
      color: white;
      border-color: transparent;
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.35);
    }
  </style>

  <script type="module" is:inline>
    const selected = new Set();
    const grid = document.getElementById('word-grid');
    const nextBtn = document.getElementById('nextBtn');
    const countEl = document.getElementById('selectedCount');
    const preferencesSection = document.getElementById('preferences-section');
    const recommendationSection = document.getElementById('recommendation-section');
    const backBtn = document.getElementById('backBtn');
    const likeBtn = document.getElementById('likeBtn');
    const dislikeBtn = document.getElementById('dislikeBtn');
    
    const cardLoading = document.getElementById('card-loading');
    const cardTitle = document.getElementById('recommendation-title');
    const cardDesc = document.getElementById('recommendation-desc');
    const suggestedTime = document.getElementById('suggested-time');

    let currentArticle = "";

    function updateCount() {
      countEl.textContent = String(selected.size);
      nextBtn.disabled = selected.size === 0;
    }

    grid.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-word]');
      if (!btn) return;
      const w = btn.dataset.word;
      if (selected.has(w)) {
        selected.delete(w);
        btn.classList.remove('selected');
        btn.setAttribute('aria-pressed', 'false');
      } else {
        selected.add(w);
        btn.classList.add('selected');
        btn.setAttribute('aria-pressed', 'true');
      }
      updateCount();
    });

    backBtn.addEventListener('click', () => {
      recommendationSection.classList.add('hidden');
      preferencesSection.classList.remove('hidden');
    });

    async function fetchRecommendation(endpoint, body) {
      cardLoading.classList.remove('opacity-0', 'pointer-events-none');
      cardLoading.classList.add('opacity-100');
      
      try {
        const res = await fetch(`http://localhost:8080${endpoint}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        
        if (!res.ok) {
          throw new Error(await res.text());
        }
        
        const data = await res.json();
        const content = data.response || "No recommendation received.";
        
        const lines = content.split('\n').filter(l => l.trim() !== "");
        let title = "Stylized Suggestions";
        let desc = content;
        
        if (lines.length > 0) {
          title = lines[0].replace(/^[#\-\*\s]+/, '').replace(/^Title:\s*/i, '').trim();
          if (lines.length > 1) {
            desc = lines.slice(1).join('\n').replace(/^Description:\s*/i, '').trim();
          }
        }
        
        currentArticle = title;
        cardTitle.textContent = title;
        cardDesc.textContent = desc;
        suggestedTime.textContent = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        
      } catch (err) {
        console.error(err);
        cardTitle.textContent = "Recommendation Offline";
        cardDesc.textContent = "Could not communicate with the local Express AI server. Please make sure the backend server (Server_src) is running on port 8080.";
      } finally {
        cardLoading.classList.remove('opacity-100');
        cardLoading.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    nextBtn.addEventListener('click', () => {
      preferencesSection.classList.add('hidden');
      recommendationSection.classList.remove('hidden');
      
      const payload = Array.from(selected);
      fetchRecommendation('/start', { preferences: payload });
    });

    likeBtn.addEventListener('click', () => {
      fetchRecommendation('/like', { article: currentArticle });
    });

    dislikeBtn.addEventListener('click', () => {
      fetchRecommendation('/dislike', { article: currentArticle });
    });
  </script>
</Layout>